# Passerelle paiement ISTC Kimpese — copier vers .env et remplir
PORT=3000
PUBLIC_URL=https://votre-domaine.com
AGGREGATOR_URL=https://api.maxicash.cd/api/v1/collect
AGGREGATOR_API_KEY=sk_xxx
AGGREGATOR_MERCHANT_ID=ISTC_KIMPESE_xxx
WEBHOOK_SECRET=istc_webhook_secret_aleatoire
ORANGE_MERCHANT=OMT12345
MPESA_MERCHANT=123456
MTN_MERCHANT=MOMO1234
AIRTEL_MERCHANT=AM1234
FLUTTERWAVE_SECRET=FLWSECK-xxx
# Base externe (optionnel) — active si défini, sinon JSON local
# Choix: mongodb | postgres | firebase | supabase
DB_PROVIDER=mongodb
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/istc
MONGODB_DB=istc
# ou
DATABASE_URL=postgres://user:pass@host:5432/istc
PG_SSL=true
# ou Firebase
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# ou Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJxxx
# SMTP déjà dans settings.json
